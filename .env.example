# Copy to .env for local use, or set these in the Render dashboard.
# .env is gitignored — never commit real values. The app loads .env at
# startup; a real environment variable always wins over the file.

# PostgreSQL. Format: postgresql+psycopg://user:pass@host:5432/db
# URL-encode any special characters in the password (@ becomes %40).
DATABASE_URL=

# Signs the session cookie. Any long random string. Changing it signs
# everybody out. (MAEC_SECRET_KEY is still honoured as a fallback.)
SESSION_SECRET=

# The RSA private key that signs identity tokens (PEM, 2048 bits or more).
# Locally it may be left unset: an ephemeral key is generated per run, and
# tokens stop verifying on restart. On Render the service refuses to start
# without one. One line with literal \n is accepted. Never commit a real key.
#   python -c "from cryptography.hazmat.primitives.asymmetric import rsa; from cryptography.hazmat.primitives import serialization as s; print(rsa.generate_private_key(public_exponent=65537, key_size=2048).private_bytes(s.Encoding.PEM, s.PrivateFormat.PKCS8, s.NoEncryption()).decode())"
OIDC_PRIVATE_KEY=
# A new id for every new key. Unset, the key's RFC 7638 thumbprint is used.
OIDC_KEY_ID=
# What every token's `iss` says. Locally: http://auth.maec.local:8000
OIDC_ISSUER=

# The first Global Admin. The seed creates this account; re-running the seed
# with a different password resets it. See the password rules below.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# An ordinary engineer for testing the non-admin path. Created ONLY when
# both are set — leave them unset on any shared or production environment.
SEED_TEST_USER_EMAIL=
SEED_TEST_USER_PASSWORD=

# Passwords must be at least 8 characters and contain an uppercase letter, a
# lowercase letter, a digit and a symbol. Enforced server-side wherever a
# password is set, so a value here that breaks the rules makes the seed refuse
# rather than creating an account you cannot sign in to.

# The seed never overwrites an existing password. Set this to 1 for ONE run to
# re-apply BOOTSTRAP_ADMIN_PASSWORD — the recovery path for a locked-out admin
# — then unset it, so a later restart cannot undo a password someone changed.
# SEED_RESET_PASSWORDS=1
