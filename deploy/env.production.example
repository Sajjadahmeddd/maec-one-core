# MAEC One Core — production settings. A TEMPLATE: placeholders only.
#
#   cp deploy/env.production.example deploy/env.production
#   chmod 600 deploy/env.production
#
# deploy/env.production is never committed (.gitignore: .env.*, and the
# .dockerignore keeps it out of the image). Generate every secret ON THE
# SERVER. Never reuse a value that has been pasted into a chat, a ticket or
# a commit — including the engineering gate secret used during development.

# --- the mode. Production refuses to start without SESSION_SECRET and
# OIDC_PRIVATE_KEY; only "development" may generate them.
MAEC_ENV=production

# --- addresses. REQUIRED: production refuses to start without either.
# Where sign-in links point. Must be https. Unset, links would be built from the
# address an app used to reach Core — http://maec-core:8000, unreachable from a browser.
CORE_PUBLIC_URL=https://auth.mirageaec.com
# One cookie for every app under mirageaec.com (OPEN-DECISIONS #19). Unset, the
# cookie is host-only and single sign-on silently stops working.
SESSION_COOKIE_DOMAIN=.mirageaec.com

# --- Core's own network, and so its trusted proxies. compose.example.yml
# builds TRUSTED_PROXIES as "127.0.0.1,<this range>"; pick a range no other
# Docker network on the host uses.
CORE_NET_SUBNET=172.31.250.0/24

# --- the database (compose builds DATABASE_URL from this; hex needs no escaping)
#   openssl rand -hex 24
POSTGRES_PASSWORD=<generate on the server>

# --- signs the session cookie. Changing it signs everybody out.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=<generate on the server>

# --- signs identity tokens (the dormant OIDC path, #11). Required all the same:
# production will not start without it. One line, with literal \n, and INSIDE
# SINGLE QUOTES: unquoted, Docker Compose turns each \n into a real line break
# and then refuses the whole file. This prints the finished line:
#   echo "OIDC_PRIVATE_KEY='$(openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | awk 'NF {printf "%s\\n", $0}')'"
OIDC_PRIVATE_KEY='<generate on the server>'
# A new id for every new key.
OIDC_KEY_ID=<e.g. core-2026-10>
OIDC_ISSUER=https://auth.mirageaec.com

# --- each app's gate secret. The same value goes into that app's settings
# (Engineering Tools: MAEC_GATE_SECRET). 32+ characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GATE_SECRETS=engineering=<generate on the server>

# --- the first Global Admin, created by the seed on first start.
BOOTSTRAP_ADMIN_EMAIL=<a named person's address>
# 8+ characters with an uppercase letter, a lowercase letter, a digit and a symbol.
BOOTSTRAP_ADMIN_PASSWORD=<generate on the server>

# --- session lifetimes (defaults shown)
SESSION_ABSOLUTE_HOURS=10
SESSION_IDLE_MINUTES=120

# --- uvicorn workers. Rate limits are kept per worker, in memory (#20).
WEB_CONCURRENCY=2

# SEED_TEST_USER_* are deliberately absent: the test engineer is for
# developer machines only.
